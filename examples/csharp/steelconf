!muf 4
;; Exemple complet: bakes build_debug/build_release et sorties ciblees

[workspace]
  .set name "example-csharp"
  .set root "."
  .set target_dir "target"
  .set profile "release"
..

[profile debug]
  .set opt 0
..

[profile release]
  .set opt 2
..

[tool dotnet]
  .exec "dotnet"
..

[bake build_debug]
  .make csproj file "app.csproj"
  [run dotnet]
    .set "build" 1
    .set "app.csproj" 1
    .set "-c" "Debug"
    .set "-o" "target/out/debug"
  ..
  .output exe "target/out/debug/app.dll"
..

[bake build_release]
  .make csproj file "app.csproj"
  [run dotnet]
    .set "build" 1
    .set "app.csproj" 1
    .set "-c" "Release"
    .set "-o" "target/out/release"
  ..
  .output exe "target/out/release/app.dll"
..

[export]
  .ref build_debug
  .ref build_release
..
