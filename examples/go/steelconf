!muf 4
;; Exemple complet: bakes build_debug/build_release et sorties ciblees

[workspace]
  .set name "example-go"
  .set root "."
  .set target_dir "target"
  .set profile "release"
..

[profile debug]
  .set opt 0
  .set debug 1
..

[profile release]
  .set opt 2
  .set debug 0
..

[tool go]
  .exec "go"
..

[bake build_debug]
  .make go_src cglob "cmd/app/**/*.go"
  [run go]
    .set "build" 1
    .set "-gcflags" "all=-N -l"
    .set "-o" "target/out/go_app_debug"
    .takes go_src as "@args"
  ..
  .output exe "target/out/go_app_debug"
..

[bake build_release]
  .make go_src cglob "cmd/app/**/*.go"
  [run go]
    .set "build" 1
    .set "-o" "target/out/go_app_release"
    .takes go_src as "@args"
  ..
  .output exe "target/out/go_app_release"
..

[export]
  .ref build_debug
  .ref build_release
..
