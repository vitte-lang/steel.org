!muf 4
;; steelconfig — OCaml example (bytecode + native)
;; Convention: build=bytecode, package=native.

[workspace]
  .set name "ocaml_example"
  .set root "."
  .set target_dir "target"
  .set profile "debug"
..

[profile debug]
  .set opt 0
  .set debug 1
..

[profile release]
  .set opt 2
  .set debug 0
..

[tool ocamlc]
  .exec "ocamlc"
..

[tool ocamlopt]
  .exec "ocamlopt"
..

[bake build]
  .make ml_src cglob "ultra/src/**/*.ml"
  [run ocamlc]
    .set "-g" 1
    .set "-I" "ultra/src"
    .set "-I" "+unix"
    .set "unix.cma" 1
    .takes ml_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/ocaml_example.byte"
..

[bake package]
  .make ml_src cglob "ultra/src/**/*.ml"
  [run ocamlopt]
    .set "-O2" 1
    .set "-I" "ultra/src"
    .set "-I" "+unix"
    .set "unix.cmxa" 1
    .takes ml_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/ocaml_example"
..

[export]
  .ref build
  .ref package
..
