!muf 4
;; Exemple complet: bakes build_debug/build_release et sorties ciblees

[workspace]
  .set name "example-cpp"
  .set root "."
  .set target_dir "target"
  .set profile "release"
..

[profile debug]
  .set opt 0
  .set debug 1
..

[profile release]
  .set opt 2
  .set debug 0
..

[tool cxx]
  .exec "c++"
..

[bake build_debug]
  .make cpp_src cglob "src/**/*.cpp"
  [run cxx]
    .set "-std=c++20" 1
    .set "-O${opt}" 1
    .set "-g" "${debug}"
    .takes cpp_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/cpp_app_debug"
..

[bake build_release]
  .make cpp_src cglob "src/**/*.cpp"
  [run cxx]
    .set "-std=c++20" 1
    .set "-O${opt}" 1
    .set "-g" "${debug}"
    .takes cpp_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/cpp_app_release"
..

[export]
  .ref build_debug
  .ref build_release
..
