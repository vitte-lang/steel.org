!muf 4
;; steelconf — GCC C example

[workspace]
  .set name "gcc_c"
  .set root "."
  .set target_dir "target"
  .set profile "debug"
..

[profile debug]
  .set opt 0
  .set debug 1
..

[profile release]
  .set opt 2
  .set debug 0
  .set lto 1
..

[tool cc]
  .exec "cc"
..

[tool ar]
  .exec "ar"
..

[bake build]
  .make c_src cglob "src/**/*.c"
  [run cc]
    .takes c_src as "@args"
    .set "-O${opt}" 1
    .set "-g" "${debug}"
    .emits exe as "-o"
  ..
  .output exe "target/out/gcc_c"
..

[export]
  .ref build
..
