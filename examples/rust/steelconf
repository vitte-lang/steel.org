!muf 4
;; Exemple complet: bakes build_debug/build_release et sorties ciblees

[workspace]
  .set name "example-rust"
  .set root "."
  .set target_dir "target"
  .set profile "release"
..

[profile debug]
  .set opt 0
  .set debug 2
..

[profile release]
  .set opt 2
  .set debug 0
..

[tool rustc]
  .exec "rustc"
..

[bake build_debug]
  .make main file "src/main.rs"
  [run rustc]
    .set "-C" "opt-level=${opt}"
    .set "-C" "debuginfo=${debug}"
    .takes main as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/rust_app_debug"
..

[bake build_release]
  .make main file "src/main.rs"
  [run rustc]
    .set "-C" "opt-level=${opt}"
    .set "-C" "debuginfo=${debug}"
    .takes main as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/rust_app_release"
..

[export]
  .ref build_debug
  .ref build_release
..
