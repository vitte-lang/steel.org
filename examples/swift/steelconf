!muf 4
;; Steelconf preconstruit pour un projet Swift complet

[workspace]
  .set name "example-swift"
  .set root "."
  .set target_dir "target"
  .set profile "release"
..

[profile debug]
  .set opt 0
  .set debug 1
..

[profile release]
  .set opt 2
  .set debug 0
..

[tool swiftc]
  .exec "swiftc"
..

[tool swiftformat]
  .exec "swiftformat"
..

[bake format]
  .make swift_src cglob "Sources/**/*.swift"
  [run swiftformat]
    .takes swift_src as "@args"
  ..
..

[bake build_debug]
  .make swift_src cglob "Sources/**/*.swift"
  [run swiftc]
    .set "-g" 1
    .takes swift_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/swift_app_debug"
..

[bake build_release]
  .make swift_src cglob "Sources/**/*.swift"
  [run swiftc]
    .set "-O" 1
    .takes swift_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "target/out/swift_app_release"
..

[bake run_debug]
  .ref build_debug
  [run exe]
    .from build_debug exe
  ..
..

[bake run_release]
  .ref build_release
  [run exe]
    .from build_release exe
  ..
..

[bake clean]
  [run rm]
    .set "-rf" 1
    .set "target" 1
  ..
..

[export]
  .ref format
  .ref build_debug
  .ref build_release
  .ref run_debug
  .ref run_release
  .ref clean
..
