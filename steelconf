!muf 4
;; steelconf — workspace root (C/Rust/Java/Python/OCaml)
;; Convention: <lang>_build / <lang>_test / <lang>_package

[workspace]
  .set name "muffin_workspace"
  .set root "."
  .set target_dir "target"
  .set profile "debug"
..

[profile debug]
  .set opt 0
  .set debug 1
..

[profile release]
  .set opt 2
  .set debug 0
..

[tool javac]
  .exec "javac"
..

[tool jar]
  .exec "jar"
..

[tool mvn]
  .exec "mvn"
..

[tool gradle]
  .exec "gradle"
..

[tool cc]
  .exec "cc"
..

[tool ar]
  .exec "ar"
..

[tool cargo]
  .exec "cargo"
..

[tool ocamlc]
  .exec "ocamlc"
..

[tool ocamlopt]
  .exec "ocamlopt"
..

[tool python]
  .exec "python3"
..

[tool sh]
  .exec "sh"
..

[bake java_build]
  .make java_src cglob "examples/java/src/main/java/**/*.java"
  [run javac]
    .set "-d" "examples/java/target/classes"
    .takes java_src as "@args"
  ..
  .output classes "examples/java/target/classes"
..

[bake java_package]
  .make java_src cglob "examples/java/src/main/java/**/*.java"
  [run javac]
    .set "-d" "examples/java/target/classes"
    .takes java_src as "@args"
  ..
  [run jar]
    .set "-c" 1
    .set "-f" "examples/java/target/out/app.jar"
    .set "-e" "com.example.App"
    .set "-C" "examples/java/target/classes"
    .set "." 1
  ..
  .output jar "examples/java/target/out/app.jar"
..

[bake java_test]
  .make mvn_inputs cglob "examples/java/pom.xml"
  [run mvn]
    .set "-q" 1
    .set "-f" "examples/java/pom.xml"
    .set "test" 1
  ..
  .output report "examples/java/target/surefire-reports"
..

[bake java_package_maven]
  .make mvn_inputs cglob "examples/java/pom.xml"
  [run mvn]
    .set "-q" 1
    .set "-f" "examples/java/pom.xml"
    .set "test" 1
    .set "package" 1
  ..
  .output jar "examples/java/target/steel-java-example-0.1.0.jar"
..

[bake java_package_gradle]
  .make gradle_inputs cglob "examples/java/build.gradle"
  [run gradle]
    .set "-p" "examples/java"
    .set "test" 1
    .set "build" 1
  ..
  .output jar "examples/java/build/libs/steel-java-example-0.1.0.jar"
..

[bake ocaml_build]
  .make ml_src cglob "examples/ocaml/ultra/src/**/*.ml"
  [run ocamlc]
    .set "-g" 1
    .set "-I" "examples/ocaml/ultra/src"
    .set "-I" "+unix"
    .set "unix.cma" 1
    .takes ml_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "examples/ocaml/target/out/ocaml_example.byte"
..

[bake ocaml_package]
  .make ml_src cglob "examples/ocaml/ultra/src/**/*.ml"
  [run ocamlopt]
    .set "-O2" 1
    .set "-I" "examples/ocaml/ultra/src"
    .set "-I" "+unix"
    .set "unix.cmxa" 1
    .takes ml_src as "@args"
    .emits exe as "-o"
  ..
  .output exe "examples/ocaml/target/out/ocaml_example"
..

[bake python_build]
  .make py_src cglob "examples/cpython/ultra/cli/*.py"
  [run sh]
    .set "-c" "cd examples/cpython/ultra && python3 -u -m cli.main"
  ..
  .output exe "examples/cpython/ultra/target/out/app.run"
..

[bake python_test]
  .make py_src cglob "examples/cpython/ultra/tests/*.py"
  [run sh]
    .set "-c" "cd examples/cpython/ultra && python3 -u -m tests.run"
  ..
  .output exe "examples/cpython/ultra/target/out/tests.run"
..

[bake c_build]
  .make c_src cglob "examples/gcc/C/src/**/*.c"
  [run cc]
    .takes c_src as "@args"
    .set "-O${opt}" 1
    .set "-g" "${debug}"
    .emits exe as "-o"
  ..
  .output exe "examples/gcc/C/target/out/gcc_c"
..

[bake rust_build]
  .make rust_src cglob "src/**/*.rs"
  [run sh]
    .set "-c" "cargo build && mkdir -p target/out/rust && cp target/debug/steel target/out/rust/steel"
  ..
  .output exe "target/out/rust/steel"
..

[bake rust_test]
  .make rust_src cglob "src/**/*.rs"
  [run sh]
    .set "-c" "cargo test && mkdir -p target/out/rust && touch target/out/rust/tests.ok"
  ..
  .output report "target/out/rust/tests.ok1"
..

[bake rust_package]
  .make rust_src cglob "src/**/*.rs"
  [run sh]
    .set "-c" "cargo build --release && mkdir -p target/out/rust && cp target/release/steel target/out/rust/steel.release"
  ..
  .output exe "target/out/rust/steel.release"
..

[export]
  .ref java_build
  .ref java_test
  .ref java_package
  .ref java_package_maven
  .ref java_package_gradle
  .ref ocaml_build
  .ref ocaml_package
  .ref python_build
  .ref python_test
  .ref c_build
  .ref rust_build
  .ref rust_test
  .ref rust_package
..
