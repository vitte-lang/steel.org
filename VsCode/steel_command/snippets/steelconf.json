{
  "workspace block": {
    "prefix": "workspace",
    "body": [
      "[workspace]",
      "  .set name \"${1:project_name}\"",
      "  .set root \"${2:.}\"",
      "  .set target_dir \"${3:target}\"",
      "  .set profile \"${4:debug}\"",
      ".."
    ],
    "description": "Workspace block"
  },
  "profile block": {
    "prefix": "profile",
    "body": [
      "[profile ${1:debug}]",
      "  .set opt ${2:0}",
      "  .set debug ${3:1}",
      ".."
    ],
    "description": "Profile block"
  },
  "tool block": {
    "prefix": "tool",
    "body": [
      "[tool ${1:name}]",
      "  .exec \"${2:tool_exec}\"",
      ".."
    ],
    "description": "Tool block"
  },
  "bake block": {
    "prefix": "bake",
    "body": [
      "[bake ${1:name}]",
      "  .make ${2:src} ${3:glob} \"${4:src/*.c}\"",
      "  [run ${5:tool}]",
      "    .set \"${6:-O2}\" ${7:1}",
      "  ..",
      "  .output ${8:exe} \"${9:target/out/app}\"",
      ".."
    ],
    "description": "Bake block with run"
  },
  "run block": {
    "prefix": "run",
    "body": [
      "[run ${1:tool}]",
      "  .set \"${2:flag}\" ${3:value}",
      ".."
    ],
    "description": "Run block"
  },
  "export block": {
    "prefix": "export",
    "body": [
      "[export]",
      "  .ref ${1:target}",
      ".."
    ],
    "description": "Export block"
  }
}
