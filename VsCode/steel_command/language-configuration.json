{
  "comments": {
    "lineComment": ";;"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "{", "close": "}"},
    {"open": "\"", "close": "\""}
  ],
  "surroundingPairs": [
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "{", "close": "}"},
    {"open": "\"", "close": "\""}
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\[[^\\]]+\\]\\s*$",
    "decreaseIndentPattern": "^\\s*\\.\\.\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\[[^\\]]+\\]\\s*$",
      "action": { "indentAction": "Indent" }
    },
    {
      "beforeText": "^\\s*\\.\\.\\s*$",
      "afterText": "^\\s*$",
      "action": { "indentAction": "Outdent" }
    }
  ]
}
