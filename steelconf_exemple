!muf 4
;; Exemple minimal : build C avec gcc
;; Usage:
;;   cd /Users/vincent/Documents/Github/steel
;;   steel build steelconf_exemple.muf


[workspace]
  .set name "steel-example-c"
  .set root "."
  .set target_dir "target"
  ;; switch: "debug" or "release"
  .set profile "debug"
..


[profile debug]
  .set opt 0
  .set debug 1
  .set ndebug 0
..

[profile release]
  .set opt 2
  .set debug 0
  .set ndebug 1
..


[tool gcc]
  .exec "gcc"
..


[bake app]
  ;; récupère tous les .c sous src/
  .make c_src cglob "**/*.c"

  ;; compile + link (simple)
  [run gcc]
    .takes c_src as "@args"
    .set "-std=c17" 1
    .set "-O${opt}" 1
    .set "-g" "${debug}"
    .set "-DNDEBUG" "${ndebug}"
    .set "-Wall" 1
    .set "-Wextra" 1
    .emits exe as "-o"
  ..

  ;; binaire final
  .output exe "target/out/app"
..


[export]
  .ref app
..
